{
  "manifest_version": 3,
  "name": "Tape Deck FX (test)",
  "version": "0.0.1",
  "description": "Stage-0 test: puts the tape deck's worn-tape sound on YouTube videos played inside the Tape Deck app.",
  "content_scripts": [{
    "matches": ["https://www.youtube.com/embed/*", "https://www.youtube-nocookie.com/embed/*"],
    "js": ["fx.js", "content.js"],
    "all_frames": true,
    "run_at": "document_start"
  }],
  "browser_specific_settings": { "gecko": { "id": "tape-deck-fx@orniki9535-ultimate", "strict_min_version": "115.0" } }
}
